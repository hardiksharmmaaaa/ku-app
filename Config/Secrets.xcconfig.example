// Secrets.xcconfig template — copy to Secrets.xcconfig and fill in:
//   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
// Values come from Supabase Dashboard → Project Settings → API.
// Only the HOST goes here — "//" starts a comment in xcconfig files;
// the https:// prefix is added in Info.plist.
SUPABASE_HOST = YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
